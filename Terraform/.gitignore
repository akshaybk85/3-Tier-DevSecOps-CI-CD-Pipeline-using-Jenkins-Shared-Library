# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
terraform.tfstate.backup

# Terraform plan files
*.tfplan
*.plan

# Crash logs
crash.log

# CLI config files
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable definitions (may contain secrets)
terraform.tfvars
terraform.tfvars.json
*.auto.tfvars
*.auto.tfvars.json

# Ignore local backend config
backend.tfvars

# macOS junk (you are on Mac)
.terraform.lock.hcl

.
